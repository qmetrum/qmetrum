# ---------------------------------------------------------------------------
# Qmetrum forecasting backend — example environment file.
# Copy to `.env` and fill in real values for local development. Never commit
# the populated `.env` (it's in .gitignore).
# In production (AWS App Runner / ECS), set these via Secrets Manager or
# the service's environment configuration.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Local SQLite (default if unset):
DATABASE_URL=sqlite:///./qmetrum.db
#
# Postgres (RDS / Aurora / managed):
# DATABASE_URL=postgresql+psycopg2://qmetrum:CHANGE_ME@localhost:5432/qmetrum
# DATABASE_URL=postgresql+psycopg2://qmetrum:CHANGE_ME@qmetrum.cluster-xxx.us-east-1.rds.amazonaws.com:5432/qmetrum?sslmode=require

# --- Market data vendors ---------------------------------------------------
# yahoo (default), polygon, hybrid, or alpaca
DATA_VENDOR=yahoo

# Required when DATA_VENDOR=hybrid or alpaca
# ALPACA_API_KEY=PK...
# ALPACA_SECRET_KEY=...

# Required when DATA_VENDOR=polygon
# POLYGON_API_KEY=...

# --- LLM (Gemini) ----------------------------------------------------------
GOOGLE_API_KEY=AIza...

# --- Auth (Cognito) --------------------------------------------------------
# COGNITO_REGION=eu-north-1
# COGNITO_USER_POOL_ID=eu-north-1_xxxxxxxxx
# COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- CORS (production) -----------------------------------------------------
# In dev we default to allow_all=True for convenience. In production set
# CORS_ALLOW_ALL=false and list the explicit Amplify URL(s):
# CORS_ALLOW_ALL=false
# CORS_ALLOW_ORIGINS=https://main.dxxxxxxxxxx.amplifyapp.com,https://qmetrum.io
